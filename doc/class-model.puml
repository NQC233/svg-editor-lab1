@startuml
title 图形模型（当前已实现部分，截至 Ticket 11）

abstract class Shape {
  +get id(): string
  +get label(): string
  +get type(): string
  +get fill(): string | undefined
  +get stroke(): string | undefined
  +get strokeWidth(): number | undefined
  +setAttribute(attribute, value): ShapeAttributeSnapshot
  +movementAnchor(): Point | undefined
  +treeAttributes(): string
  +detailLines(): readonly string[]
}

abstract class LeafShape {
  +movementAnchor(): Point
  +moveOwnGeometry(dx, dy): void
  +scaleOwnGeometry(factor): void
  +snapshotGeometry(): GeometrySnapshot
}

abstract class Container

class Group
class Rect
class Circle
class Ellipse
class Line
class Text
class GeometrySnapshot {
  +restore(): void
  +matchesCurrent(): boolean
}

class ShapeAttributeSnapshot {
  +get attribute(): string
  +get changed(): boolean
  +get previousValue(): string | undefined
  +get currentValue(): string
  +restore(): void
}

class Point {
  +get x(): number
  +get y(): number
}

class ShapePlacement {
  +get parent(): Container | undefined
  +get index(): number
}

class UngroupSnapshot {
  +get container(): Container
  +get parent(): Container
  +get index(): number
  +get children(): readonly Shape[]
}

class SvgDocument {
  +get width(): number
  +get height(): number
  +get rootShapes(): readonly Shape[]
  +childrenOf(shape): readonly Shape[]
  +find(id): Shape | undefined
  +require(id): Shape
  +appendShape(shape, container?): number
  +insertShape(shape, index, container?): void
  +removeShape(shape): ShapePlacement
  +ungroup(container): UngroupSnapshot
  +restoreUngrouped(snapshot): void
  +moveToEnd(shape, container): ShapePlacement | undefined
  +restorePlacement(shape, placement): void
  +requireContainer(id): Container
  +parentLabelOf(shape): string
  +move(shape, dx, dy): readonly GeometrySnapshot[]
  +scale(shape, factor): readonly GeometrySnapshot[]
}

class ShapeFactory {
  +create(type, id, args): Shape
}

Shape <|-- LeafShape
Shape <|-- Container
Container <|-- Group
LeafShape <|-- Rect
LeafShape <|-- Circle
LeafShape <|-- Ellipse
LeafShape <|-- Line
LeafShape <|-- Text
SvgDocument o-- Shape : roots, children, id/parent index
SvgDocument --> Container : validated structure changes
SvgDocument --> GeometrySnapshot : creates transaction snapshots
SvgDocument --> ShapePlacement : returns removal or relocation origin
SvgDocument --> UngroupSnapshot : captures and restores structure
LeafShape ..> GeometrySnapshot : captures exact geometry
LeafShape ..> Point : exposes movement anchor
ShapeFactory ..> Shape : creates
Shape ..> ShapeAttributeSnapshot : returns attribute memento
@enduml

@startuml
title 命令与历史（当前已实现部分，截至 Ticket 11）

abstract class Command {
  +execute(context, args): CommandResult
}

abstract class DocumentCommand

abstract class EditCommand {
  +undo(context): CommandResult
  +redo(context): CommandResult
}

class CommandResult
class CommandCatalog
class CommandInvoker
class CommandHistory
class CommandContext
class ShapePlacement
class UngroupSnapshot

class CreateCommand
class DeleteCommand
class UngroupCommand
class AddToContainerCommand
class MoveCommand
class ScaleCommand
class SetCommand
class CanvasCommand
class InitCommand
class TreeCommand
class ShowCommand
class HelpCommand
class UndoCommand
class RedoCommand

Command <|-- EditCommand
Command <|-- DocumentCommand
EditCommand <|.. CreateCommand
EditCommand <|.. DeleteCommand
EditCommand <|.. UngroupCommand
EditCommand <|.. AddToContainerCommand
EditCommand <|.. MoveCommand
EditCommand <|.. ScaleCommand
EditCommand <|.. SetCommand
DocumentCommand <|.. CanvasCommand
DocumentCommand <|.. InitCommand
Command <|.. TreeCommand
Command <|.. ShowCommand
Command <|.. HelpCommand
Command <|.. UndoCommand
Command <|.. RedoCommand

CommandInvoker --> CommandHistory
CommandInvoker --> Command
CommandInvoker --> CommandResult
CommandCatalog --> Command : creates via factory
CommandHistory o-- EditCommand
CommandHistory --> CommandResult
Command --> CommandContext
Command --> CommandResult
DeleteCommand --> ShapePlacement : restores original position
UngroupCommand --> UngroupSnapshot : restores original container
AddToContainerCommand --> ShapePlacement : restores original parent and index
MoveCommand --> GeometrySnapshot : keeps undo snapshots
ScaleCommand --> GeometrySnapshot : keeps undo snapshots
SetCommand --> ShapeAttributeSnapshot : keeps previous attribute
@enduml
