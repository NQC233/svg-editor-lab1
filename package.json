{
  "name": "svg-editor-lab1",
  "version": "0.1.0",
  "private": true,
  "description": "Lab1 Phase 1: an object-oriented SVG CLI editor",
  "type": "module",
  "engines": {
    "node": "24.x"
  },
  "scripts": {
    "cli": "tsx src/main.ts",
    "build": "tsc -p tsconfig.build.json",
    "start": "node dist/main.js",
    "typecheck": "tsc --noEmit",
    "test": "node --import tsx --test \"test/**/*.test.ts\"",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "check": "npm run typecheck && npm run format:check && npm test && npm run build"
  },
  "devDependencies": {
    "@types/node": "24.19.2",
    "prettier": "3.9.10",
    "tsx": "4.23.15",
    "typescript": "7.0.2"
  }
}
